        },
        {
          "name": "Refund Completed (pg.refund.completed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "{{webhook_auth_sha256}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"pg.refund.completed\",\n  \"payload\": {\n    \"merchantId\": \"{{merchantId_upper}}\",\n    \"merchantRefundId\": \"{{merchant_refund_id}}\",\n    \"originalMerchantOrderId\": \"{{merchant_order_id}}\",\n    \"amount\": 100,\n    \"state\": \"COMPLETED\",\n    \"timestamp\": 1730869961754,\n    \"refundId\": \"OMR7878098045517540996\",\n    \"splitInstruments\": [\n      {\n        \"amount\": 100,\n        \"rail\": {\n          \"type\": \"UPI\",\n          \"utr\": \"586756785\",\n          \"upiTransactionId\": \"YBL5bc011fa9f8644763b52b96a29a9655\",\n          \"vpa\": \"12****78@ybl\"\n        },\n        \"instrument\": {\n          \"type\": \"ACCOUNT\",\n          \"maskedAccountNumber\": \"******1234\",\n          \"accountType\": \"SAVINGS\"\n        }\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{mock_base_url}}/checkout/webhook",
              "host": ["{{mock_base_url}}"],
              "path": ["checkout", "webhook"]
            },
            "description": "Sample pg.refund.completed callback, sent when a refund is successfully processed."
          },
          "response": [
            {
              "name": "Refund Completed",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "{{webhook_auth_sha256}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"event\": \"pg.refund.completed\"\n}"
                },
                "url": {
                  "raw": "{{mock_base_url}}/checkout/webhook",
                  "host": ["{{mock_base_url}}"],
                  "path": ["checkout", "webhook"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"event\": \"pg.refund.completed\",\n  \"payload\": {\n    \"merchantId\": \"merchantId\",\n    \"merchantRefundId\": \"merchantRefundId\",\n    \"originalMerchantOrderId\": \"Order123\",\n    \"amount\": 100,\n    \"state\": \"COMPLETED\",\n    \"timestamp\": 1730869961754,\n    \"refundId\": \"OMR7878098045517540996\",\n    \"splitInstruments\": [\n      {\n        \"amount\": 100,\n        \"rail\": {\n          \"type\": \"UPI\",\n          \"utr\": \"586756785\",\n          \"upiTransactionId\": \"YBL5bc011fa9f8644763b52b96a29a9655\",\n          \"vpa\": \"12****78@ybl\"\n        },\n        \"instrument\": {\n          \"type\": \"ACCOUNT\",\n          \"maskedAccountNumber\": \"******1234\",\n          \"accountType\": \"SAVINGS\"\n        }\n      }\n    ]\n  }\n}"
            }
          ]
        },
